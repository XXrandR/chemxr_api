# Configuracion de sqlfluff para chemxr_api (migraciones Flyway PostgreSQL)
#
# Politica de identifiers y keywords (RF04/RF06 coherentes entre si):
#   - Los identifiers normales van SIN comillas (RF06 los limpia).
#   - Las keywords usadas como identificadores (name, role, settings,
#     label, version, locale, summary, source, value, comments, options,
#     content, format, geometry, location, notify, provider, configuration)
#     van SIEMPRE entrecomilladas: RF06 exige el quote y RF04 no los
#     reclama por estar entrecomillados (quoted_identifiers_policy = none).

[sqlfluff]
dialect = postgres

# Lint completo de migraciones grandes (sqlfluff omite >20KB y >100k nodos por defecto).
large_file_skip_byte_limit = 0
max_parse_nodes = 0

[sqlfluff:rules:references.quoting]
prefer_quoted_keywords = true

[sqlfluff:rules:references.keywords]
quoted_identifiers_policy = none

# Literales booleanos/null SIEMPRE en upper (TRUE/FALSE/NULL): coincide
# con el estilo del DDL (NOT NULL, IS NULL) y elimina la ambiguedad del
# modo 'consistent' de CP04 (que alternaba entre upper y lower segun
# el contexto y generaba 5 falsos ajustes a 'null' en lowercase).
[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper
